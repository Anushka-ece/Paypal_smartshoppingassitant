{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run PennyPilot backend",
			"type": "shell",
			"command": "C:/Users/ANUSH/AppData/Local/Microsoft/WindowsApps/python3.13.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--app-dir",
				"project_ver_1/backend",
				"--reload"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run PennyPilot web dashboard",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--hostname",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Install and run PennyPilot web",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
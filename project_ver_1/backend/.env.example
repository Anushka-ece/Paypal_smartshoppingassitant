DATABASE_URL=sqlite:///./paypal_family_budget.db
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your_gemini_api_key_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_ALLOW_MOCK_WEBHOOKS=false
PAYPAL_CHECKOUT_RETURN_URL=http://localhost:3000/requests?checkout=return&request_id={request_id}
PAYPAL_CHECKOUT_CANCEL_URL=http://localhost:3000/requests?checkout=cancel&request_id={request_id}
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
TOKEN_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-bytes
